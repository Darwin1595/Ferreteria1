<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/proinstalar_primary_dark" />
            <corners android:radius="8dp" />
            <size android:width="10dp" android:height="64dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/proinstalar_primary" />
            <corners android:radius="8dp" />
            <size android:width="8dp" android:height="64dp" />
        </shape>
    </item>
</selector>