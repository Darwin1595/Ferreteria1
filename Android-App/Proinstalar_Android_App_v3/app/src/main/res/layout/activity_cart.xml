<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/proinstalar_bg_light"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/proinstalar_white"
        android:elevation="4dp">
        <ImageButton
            android:id="@+id/btnVolverCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/proinstalar_dark_steel" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Carrito de Compras"
            android:textColor="@color/proinstalar_dark_steel"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <TextView
        android:id="@+id/tvCarritoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="Tu carrito está vacío" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"/>
    <LinearLayout
        android:id="@+id/layoutPagar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/proinstalar_white"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="8dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total a Pagar:"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvTotalCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="$ 0.0"
                android:textColor="@color/proinstalar_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </RelativeLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPagar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIRMAR COMPRA"
            app:backgroundTint="@color/proinstalar_primary"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
