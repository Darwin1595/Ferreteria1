<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/proinstalar_bg_light"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/proinstalar_white"
        android:elevation="4dp"
        android:padding="20dp">
        <ImageButton
            android:id="@+id/btnVolverContacto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/proinstalar_dark_steel" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Contáctanos"
            android:textColor="@color/proinstalar_dark_steel"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROINSTALAR Ferretería"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Horario de atención"
                        android:textColor="@color/proinstalar_text_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvHorarioContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Teléfono"
                        android:textColor="@color/proinstalar_text_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvTelefonoContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Dirección"
                        android:textColor="@color/proinstalar_text_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDireccionContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="ESCRIBIR POR WHATSAPP"
                app:backgroundTint="@color/proinstalar_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLlamar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="LLAMAR"
                android:textColor="@color/proinstalar_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconTint="@color/proinstalar_primary"
                app:strokeColor="@color/proinstalar_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMapa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="CÓMO LLEGAR"
                android:textColor="@color/proinstalar_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart"
                app:iconTint="@color/proinstalar_primary"
                app:strokeColor="@color/proinstalar_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>