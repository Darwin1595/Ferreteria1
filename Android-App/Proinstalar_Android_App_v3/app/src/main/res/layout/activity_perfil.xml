<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/proinstalar_bg_light"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/proinstalar_white"
        android:elevation="4dp"
        android:padding="20dp">
        <ImageButton
            android:id="@+id/btnVolverPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/proinstalar_dark_steel" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Mi Perfil"
            android:textColor="@color/proinstalar_dark_steel"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circle_light">
                <TextView
                    android:id="@+id/tvInicialPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="C"
                    android:textColor="@color/proinstalar_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <TextView
                android:id="@+id/tvNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/proinstalar_dark_steel"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvEmailPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/proinstalar_text_muted"
                android:textSize="14sp" />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono"
                        android:textColor="@color/proinstalar_text_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvTelefonoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Dirección"
                        android:textColor="@color/proinstalar_text_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDireccionPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/proinstalar_dark_steel"
                        android:textSize="15sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerfilPedidos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="MIS PEDIDOS"
                app:backgroundTint="@color/proinstalar_primary"
                app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPerfilEditar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="EDITAR MIS DATOS"
            android:textColor="@color/proinstalar_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/proinstalar_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerfilSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="MIS SOLICITUDES DE SERVICIO"
                app:backgroundTint="@color/proinstalar_dark_steel"
                app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerfilSalir"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="CERRAR SESIÓN"
                android:textColor="@color/proinstalar_primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/proinstalar_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>